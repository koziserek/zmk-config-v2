    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q  &kp W  &kp E  &kp R                   &kp T           &kp Y            &kp U                  &kp I      &kp O                  &kp P
&kp A  &kp S  &kp D  &kp F                   &kp G           &kp H            &kp J                  &kp K      &kp L                  &mt LEFT_GUI SEMI
&kp Z  &kp X  &kp C  &kp V                   &kp B           &kp N            &kp M                  &kp COMMA  &mt RIGHT_CONTROL DOT  &mt RIGHT_ALT SLASH
                     &mt LEFT_CONTROL ENTER  &lt 1 ESCAPE    &lt 2 BACKSPACE  &mt RIGHT_SHIFT SPACE
            >;
        };

        leftThumb {
            bindings = <
&kp N1         &kp N2   &kp N3   &kp N4            &kp N5                       &kp N6        &kp N7           &kp N8      &kp N9         &kp N0
&kp F14        &kp F15  &kp F16  &kp F17           &kp F18                      &kp LS(LEFT)  &kp LS(DOWN)     &kp LS(UP)  &kp LS(RIGHT)  &mt_sk LEFT_SHIFT LS(LA(LC(LEFT_META)))
&kp LC(BACKSPACE)  &kp F21  &kp TAB  &kp LEFT_GUI  &to 4                        &kp C_PLAY_PAUSE  &kp C_VOL_DN  &kp C_VOL_UP     &kp C_NEXT         &kp PIPE
                                                 &sl 5   &trans                 &trans      &trans
            >;
        };

        rightThumb {
            bindings = <
&kp LBRC                              &kp RBRC  &kp LBKT  &kp RBKT       &kp TILDE    &kp EQUAL       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DEL    &kp DOUBLE_QUOTES
&kp F19                               &kp F20   &kp F24   &kp F22        &kp F23      &kp LEFT        &kp DOWN              &kp UP                 &kp RIGHT  &kp SQT
&kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT  &kp HOME  &kp END   &to 4          &tog 4       &kp UNDERSCORE    &kp KP_MINUS           &kp KP_PLUS         &kp GRAVE  &caps_word
                                                          &trans     &trans       &trans   &to 5       
            >;
        };

        bothThumbs {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F6       &kp F7      &kp F8  &kp F9  &kp F10
&kp F11       &kp F12       &m_sga        &m_rfid       &bootloader     &bootloader  &trans      &trans  &trans  &kp PRINTSCREEN
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp SYSREQ       &trans      &trans  &trans  &kp BSLH
                                          &sys_reset    &trans          &trans       &bt BT_CLR
            >;
        };

        CalculatorAndMouse {
            bindings = <
&kp N1    &kp N2    &kp N3    &kp N4            &kp N5                       &msc SCRL_UP       &msc SCRL_LEFT           &mmv MOVE_UP      &msc SCRL_RIGHT       &mkp MCLK
&kp N6    &kp N7           &kp N8      &kp N9         &kp N0                 &msc SCRL_DOWN      &mmv MOVE_LEFT         &mmv MOVE_DOWN      &mmv MOVE_RIGHT      &mkp RCLK
&kp COMMA  &kp PLUS  &kp MINUS  &kp ASTERISK  &kp SLASH                      &kp C_PLAY_PAUSE  &kp C_VOL_DN  &kp C_VOL_UP     &kp C_NEXT         &mkp MB4
                     &kp DOT  &to 0    &trans  &mkp LCLK
            >;
        };
        AMOSmacros1 {
            bindings = <
&m_q1    &m_w1     &m_e1     &m_r1         &m_t1                 &m_y1      &m_u1        &m_i1     &m_o1      &m_p1 
&m_a1    &m_s1    &m_d1      &m_f1         &m_g1                 &m_h1      &m_j1        &m_k1     &m_l1      &m_semi1
&m_z1  &m_x1 &m_c1  &m_v1  &m_b1                                 &m_n1  &m_m1  &m_comma1     &m_dot1     &m_slash1
                     &mo 6  &to 0    &to 0  &mo 7
            >;
        };
        AMOSmacros2 {
            bindings = <
&m_q2    &m_w2     &m_e2     &m_r2         &m_t2                 &m_y1      &m_u1        &m_i1     &m_o1      &m_p2 
&m_a2    &m_s2    &m_d2      &m_f2         &m_g2                 &m_h1      &m_j1        &m_k1     &m_l1      &m_semi1
&m_z2    &m_x2 &m_c2  &m_v2  &m_b2                               &m_n1  &m_m1  &m_comma1     &m_dot1     &m_slash1
                     &trans  &trans    &trans  &trans
            >;
        };
        AMOSmacros3 {
            bindings = <
&m_q1    &m_w1     &m_e1     &m_r1         &m_t1                 &m_y1      &m_u1        &m_i1     &m_o1      &m_p2 
&m_a1    &m_s1    &m_d1      &m_f1         &m_g1                 &m_h1      &m_j1        &m_k1     &m_l1      &m_semi1
&m_z1  &m_x1 &m_c1  &m_v1  &m_b1                                 &m_n1  &m_m1  &m_comma1     &m_dot1     &m_slash1
                     &trans  &trans    &trans  &trans
            >;
        };
    };




    conditional_layers {
        compatible = "zmk,conditional-layers";

        both {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
